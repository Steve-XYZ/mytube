{
  "name": "mytube",
  "version": "1.0.0",
  "description": "Cross-platform web browser with video and image download capabilities",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "build:all": "pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "start": "pnpm build:all && electron .",
    "dev:electron": "pnpm build:main && pnpm build:preload && concurrently \"vite\" \"wait-on http://localhost:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "pack": "pnpm build:all && electron-builder --dir",
    "dist": "pnpm build:all && electron-builder",
    "dist:mac": "pnpm build:all && pnpm run setup:bins:mac && pnpm run setup:pot && electron-builder --mac",
    "dist:win": "pnpm build:all && pnpm run setup:bins:win && pnpm run setup:pot && electron-builder --win",
    "dist:linux": "pnpm build:all && pnpm run setup:bins:linux && pnpm run setup:pot && electron-builder --linux",
    "release:check": "node scripts/verify-release-env.cjs",
    "icons": "bash scripts/generate-icons.sh",
    "setup": "pnpm run setup:bins && pnpm run setup:pot",
    "setup:bins": "bash scripts/download-binaries.sh",
    "setup:bins:mac": "bash scripts/download-binaries.sh mac-arm64 mac-x64",
    "setup:bins:win": "bash scripts/download-binaries.sh win-x64",
    "setup:bins:linux": "bash scripts/download-binaries.sh linux-x64",
    "setup:pot": "bash scripts/setup-pot-provider.sh",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx}' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}' 'tests/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm run build:all && playwright test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "electron",
    "browser",
    "downloader",
    "video",
    "youtube"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.29.3",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.2.1",
    "electron": "^40.4.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sharp": "0.35.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.4"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3"
  }
}
